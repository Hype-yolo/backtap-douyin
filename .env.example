HOST=127.0.0.1
PORT=8796
# Generate with: openssl rand -hex 24. Keep this private.
API_TOKEN=replace-with-a-long-random-token
RESOLVE_TIMEOUT_MS=40000
MAX_CONCURRENT=1
RATE_LIMIT_PER_MINUTE=10
# For a public demo only: no key required, mandatory global daily request quota.
# PUBLIC_ACCESS=1
# DAILY_LIMIT=100
# QUOTA_FILE=/var/lib/backtap-douyin/quota.json
# TRUST_PROXY=1
# Optional outbound proxy for Chromium. Never use a personal browser profile.
# BROWSER_PROXY=http://127.0.0.1:7890
